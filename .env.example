# AI-Powered Bug Detection System Configuration
# Copy this file to .env and configure your variables

# Optional OpenAI API Key for AI-assisted code reviews
# If left empty, the application runs purely in AST-based static analysis mode.
OPENAI_API_KEY=

# OpenAI Model configuration (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Server Host & Port
APP_HOST=127.0.0.1
APP_PORT=8000

# SQLite Database Location
DB_PATH=data/history.db
